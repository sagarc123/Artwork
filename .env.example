# Copy to .env.local for development; set the same keys in the hosting dashboard for production.

# Public site address, used for SEO links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL). Locally: postgres://postgres:<password>@localhost:5432/siddesh_art
DATABASE_URL=

# Long random secret for the admin panel. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=

# Business details (shown on the site). Leave empty until known.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Razorpay (test keys from dashboard.razorpay.com > Settings > API Keys; live keys only after KYC)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose when adding https://<your-domain>/api/webhooks/razorpay in the dashboard
RAZORPAY_WEBHOOK_SECRET=

# Shared secret for the maintenance job (/api/cron/maintenance: frees stock from abandoned checkouts, retries invoices).
# Vercel Cron (vercel.json, every 5 minutes) sends it automatically. Elsewhere, schedule:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<your-domain>/api/cron/maintenance
CRON_SECRET=

# Customer sign-in by phone OTP (MSG91 > OTP, with a DLT-approved template that has the ##OTP## variable).
# Leave MSG91_AUTH_KEY empty for TEST MODE: the code is written to the server log, and shown on the login page ONLY under `next dev`.
# In production without these two, nobody can receive a code, so set both before going live.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Email (newsletter confirm emails). Resend: resend.com > API Keys. EMAIL_FROM must be an address on a domain you verified there,
# e.g. "Siddesh Mokashi <hello@yourdomain.com>".
# Leave RESEND_API_KEY empty for TEST MODE: each email, with its links, is written to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=

# Optional analytics, loaded ONLY after the visitor says yes in the cookie banner, and never on pages for under-18 learners.
# Leave both empty and the site uses no optional cookies at all: then there is no cookie banner and no "Cookie settings" link.
# Google Analytics 4 measurement ID (looks like G-ABC123XYZ)
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) pixel ID (digits only)
NEXT_PUBLIC_META_PIXEL_ID=
