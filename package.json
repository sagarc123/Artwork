{
  "name": "siddesh-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "payload": "node node_modules/payload/bin.js --use-swc",
    "generate": "npm run payload -- generate:importmap && npm run payload -- generate:types",
    "migrate:create": "npm run payload -- migrate:create",
    "migrate": "npm run payload -- migrate",
    "seed": "npm run payload -- run scripts/seed.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "payload": "^3.91.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
